{
  "name": "learning-tmle",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.js",
    "test": "node --test tests/*.test.js tests/zh/*.test.js tests/en/*.test.js",
    "start": "node scripts/serve.js",
    "test:browser": "node tests/zh/rhc-browser.cjs",
    "build:zh": "node scripts/build.js --locale=zh",
    "build:en": "node scripts/build.js --locale=en",
    "test:browser:en": "node tests/en/browser.cjs",
    "check:pages": "node scripts/check-pages-build.js",
    "test:browser:pages": "node tests/chapter-loading-browser.cjs"
  },
  "dependencies": {
    "katex": "0.16.22",
    "marked": "15.0.12"
  },
  "devDependencies": {
    "playwright": "1.58.2"
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  }
}
