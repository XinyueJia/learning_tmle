      "line": 4,
      "code": "script_argument <- grep(\"^--file=\", commandArgs(FALSE), value = TRUE)",
      "inputs": [],
      "outputs": [
        "script_argument"
      ],
      "operation": "commandArgs(FALSE) reads the startup arguments. grep matches the start of a string using ^, and value=TRUE retains the matched strings. The result is a character vector of length zero or one locating the file run by Rscript.",
      "formulaTex": null,
      "dimensions": {
        "script_argument": []
      }
    },
    {
      "line": 6,
      "code": "source_files <- vapply(sys.frames(), function(frame) if (is.null(frame$ofile)) \"\" else frame$ofile, character(1))",
      "inputs": [],
      "outputs": [
        "source_files"
      ],
      "operation": "sys.frames() reads the call frames. vapply applies a function to each frame, requiring one character string per result. When source() runs a script, ofile records its path; frames without a path return an empty string.",
      "formulaTex": null,
      "dimensions": {
        "source_files": []
      }
    },
    {
      "line": 8,
      "code": "script_path <- if (any(nzchar(source_files))) tail(source_files[nzchar(source_files)], 1) else if (length(script_argument)) sub(\"^--file=\", \"\", script_argument[1]) else file.path(\"en\", \"R\", \"ch00.R\")",
      "inputs": [
        "source_files",
        "script_argument"
      ],
      "outputs": [
        "script_path"
      ],
      "operation": "if selects the source path: use the last non-empty ofile when called through source(); otherwise remove the --file= prefix. Code pasted into the R console at the project root defaults to this lesson’s script path. The output is one path string; [] indexing starts at 1.",
      "formulaTex": null,
      "dimensions": {
        "source_files": [],
        "script_argument": [],
        "script_path": []
      }
    },
    {
