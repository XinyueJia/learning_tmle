    },
    {
      "line": 6,
      "code": "source_files <- vapply(sys.frames(), function(frame) if (is.null(frame$ofile)) \"\" else frame$ofile, character(1))",
      "inputs": [],
      "outputs": [
        "source_files"
      ],
      "operation": "sys.frames()读取调用环境；vapply逐个返回长度1字符。被source()调用时ofile记录当前脚本路径；没有路径的环境返回空串。",
      "formulaTex": null,
      "dimensions": {
        "source_files": []
      }
    },
    {
      "line": 8,
      "code": "script_path <- if (any(nzchar(source_files))) tail(source_files[nzchar(source_files)], 1) else if (length(script_argument)) sub(\"^--file=\", \"\", script_argument[1]) else file.path(\"zh\", \"R\", \"ch05.R\")",
      "inputs": [
