      ],
      "outputs": [
        "project_root"
      ],
      "operation": "dirname取脚本目录；file.path向上两层拼接项目根，normalizePath要求目录存在。路径不依赖当前工作目录。",
      "formulaTex": null,
      "dimensions": {
